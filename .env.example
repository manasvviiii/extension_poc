# PostgreSQL is the intended production source of truth.
DATABASE_URL=postgresql://warmgraph:warmgraph_dev@127.0.0.1:5432/warmgraph
STORAGE_BACKEND=postgres
AUTH_MODE=development
# Development only. Never use this value in production.
DEV_AUTH_TOKEN=replace-with-a-local-development-token
DEV_OWNER_ID=local_demo_owner
# Optional multi-tenant development mapping. JSON object keyed by token.
DEV_AUTH_TOKENS={}