{
  "manifest_version": 3,
  "name": "Warm Intro Network POC",
  "version": "0.3.0",
  "description": "POC for reading connection data rendered on LinkedIn pages.",
  "permissions": [],
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}