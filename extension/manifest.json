{
  "manifest_version": 3,
  "name": "Warm Intro Network POC",
  "version": "0.5.0",
  "description": "Read relationship evidence rendered on LinkedIn pages.",
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "http://127.0.0.1:5500/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "http://127.0.0.1:5500/*"
      ],
      "js": [
        "overlay.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}